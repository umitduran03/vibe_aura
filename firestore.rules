rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Özel Kullanıcı Verisi (Sadece Sahibine Açık)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Açık Analiz Sonuçları
    match /results/{documentId} {
      // Herkestan paylaşım linkiyle okunabilir (Sadece direkt ID ile get işlemi)
      allow get: if true;
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Yeni yazdırma işlemleri yalnızca yetkili ve dokümana UID'sini ekleyenlere açık
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Sadece dokumanın sahibi güncelleyebilir veya silebilir
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Token Farming Önlemi — Silinen Hesap Kayıtları
    // Hesap silindiğinde kalan token bakiyesi burada saklanır.
    // Yeniden kayıtta aynı email bulunursa 5 bedava token yerine
    // kalan bakiyeyle başlatılır.
    match /deleted_accounts/{emailKey} {
      allow read, write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
